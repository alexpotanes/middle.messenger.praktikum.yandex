<li class="list__item">
    {{#if editable}}
        <label class="list__item-label" for="{{name}}">{{label}}</label>
        <input
            class="list__item-input"
            type="{{type}}"
            value="{{value}}"
            name="{{name}}"
            id="{{name}}"
        />
    {{else}}
        <span class="list__item-label">{{label}}</span>
        <span class="list__item-value">{{value}}</span>
    {{/if}}
</li>
