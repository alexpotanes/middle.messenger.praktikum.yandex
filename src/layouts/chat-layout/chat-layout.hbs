{{> sidebar}}
{{#if activeChatName}}
    <div class="messages">
        {{> messages-header name=activeChatName}}
        <section class="messages__chat">
            <ul class="messages__list">
                {{#each messages}}
                    {{> message-item}}
                {{/each}}
            </ul>
        </section>
        {{> message-input}}
    </div>
{{/if}}
{{#if modal}}{{> modal modal}}{{/if}}